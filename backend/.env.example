# Copie ce fichier en ".env" et renseigne tes propres valeurs.
# Ne commite jamais le fichier ".env" réel (contient des secrets).

# Secret utilisé pour signer les sessions (JWT). Génère une chaîne aléatoire
# longue et unique pour la production, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-moi-en-production

# Port d'écoute du serveur (Render le définit automatiquement, inutile d'y toucher)
PORT=3001

# URL de connexion à ta base Postgres (fournie par Neon, Render, etc.)
# Format : postgres://utilisateur:motdepasse@hote/nom_de_la_base?sslmode=require
# En local sans base Postgres installée, laisse vide — voir LISEZMOI.md pour
# lancer une base Postgres locale via Docker si besoin.
DATABASE_URL=

# URL(s) du frontend autorisée(s) à appeler cette API, séparées par des virgules.
# En local, laisse vide (autorise tout). En prod, mets l'URL Vercel exacte, ex :
# ALLOWED_ORIGIN=https://ton-app.vercel.app
ALLOWED_ORIGIN=
